          "_customHTML": "<section data-bs-version=\"5.1\" class=\"footer7\" group=\"Footers\" global once=\"footers\" mbr-class=\"{'mbr-reveal': reveal, 'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"8\" step=\"1\" value=\"0\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"8\" step=\"1\" value=\"4\">\n        <input type=\"checkbox\" title=\"Reveal effect\" name=\"reveal\" checked>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/background5.jpeg\">\n            <input type=\"color\" title=\"Color\" value=\"#ffe885\" selected>\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#232323\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0\" condition=\"overlay && bg.type !== 'color'\">\n        <!-- End block parameters -->\n    </mbr-parameters>\n<div class=\"container\">\n        <div class=\"media-container-row\">\n            <div class=\"col-md-8 align-center\">\n</div></div></div>&nbsp;\n<div style=\"width: 800px; margin: 0 auto; text-align: center;\">\n  <h1 style=\"text-align: center;\">\n  <style>\n  /* Общий стиль для всей области текста с тенью */\n  .text-with-shadow {\n    text-shadow: 0px 1px #000;\n  }\n</style><div class=\"text-with-shadow\">\n    <b>\n      <span style=\"font-family: Merriweather;\">\n        <span style=\"color: red;\">☑</span>&nbsp;\n        <span style=\"color: red;\">On</span>\n        <span style=\"color: #01ffff;\">лайн радио</span>\n      </span>\n    </b>\n  </div></h1>\n  <div id=\"radiobells_container\">\n    <a href=\"https://www.radiobells.com/\" rel=\"nofollow\" id=\"RP_link\">Онлайн радио</a> #radiobells_script_hash\n  </div>\n  <link href=\"https://www.radiobells.com/script/style.css\" type=\"text/css\" rel=\"stylesheet\">\n[JS_CODE_0]\n  [JS_CODE_1]\n[JS_CODE_2]  \n<br />\n<br />\n<br />    \n</div>\n</section>",
          "_JSplaceholders": [
            "<script type=\"text/javascript\">\n    var rad_backcolor=\"#006100\"; \n    var rad_logo = \"black\"; \n    var rad_autoplay = false; \n    var rad_width = \"responsive\"; \n    var rad_width_px = 330;\n    var rad_stations = [\n      ['https://retroclub.hostingradio.ru/retroclub224.aacp','Радио Ретро','retroclub'],\n      ['https://evcast.mediacp.eu:2075/stream','Р-Сов.эстрада','sovetestrada'],\n      ['https://listen7.myradio24.com/alexx333','Ностальжи','nostalgie'],\n      ['https://lk.castnow.ru:8100/80_ru_en-192.mp3','Восьмидесятые','vosmidesjatie'],\n      ['https://listen1.myradio24.com/6262','Спокойное радио','spokoinoe'],\n      ['https://retro.amgradio.ru/Retro','Ретро Хит','retrohit'],\n      ['https://pub0101.101.ru/stream/air/aac/64/100','Авторадио','avtoradio'],\n      ['https://hr.amgradio.ru/Horoshee','Хорошее радио','horoshee'],\n      ['https://icecast-zvezda.mediacdn.ru/radio/zvezda/zvezda_128','Радио Звезда','zvezda'],\n      ['https://icecast-vgtrk.cdnvideo.ru/mayakfm_mp3_128kbps','Радио Маяк','mayak'],\n      ['https://www.liveradio.es/http://online.melodiafm.ua/MelodiaFM_Romantic_HD','Мелодия FM: Romantic','melodiafmromantic'],\n      ['https://nashe1.hostingradio.ru/nashe-256','Наше радио','nashe'],\n      ['https://rusradio.hostingradio.ru/rusradio96.aacp','Русское радио','russradio'],\n      ['https://listen.rusongs.ru/ru-mp3-128','Русские песни','russong'],\n      ['https://listen2.myradio24.com/4156','Радио странствий','radiostranstviy'],\n      ['https://www.liveradio.es/http://online.hitfm.ua/HitFM_HD','Хiт FM','hitfmua'],\n      ['https://bookradio.hostingradio.ru:8069/fm','Радио Книга','radiokniga'],\n      ['https://pub0302.101.ru:8443/stream/air/aac/64/202','Comedy Radio','comediradio'],\n      ['https://rock.amgradio.ru/RusRock','Русский Рок','makradiorusrock'],\n      ['https://radiomv.hostingradio.ru:80/radiomv256.mp3','Милицейская волна','milvolna'],\n      ['https://kpradio.hostingradio.ru:8000/64?radiostatistica=r