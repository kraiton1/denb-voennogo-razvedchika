          "_customHTML": "<section data-bs-version=\"5\" group=\"Images & Videos\">\n\n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n    <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n\n    <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"8\" value=\"3\" step=\"1\" condition=\"fullWidth==false\">\n    <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"8\" value=\"1\" step=\"1\" condition=\"fullWidth==false\">\n    <input type=\"range\" inline title=\"Width\" name=\"videoSize\" min=\"20\" max=\"100\" value=\"20\" step=\"1\" condition=\"fullWidth==false\">\n\n    <input type=\"color\" title=\"Background Color\" name=\"bgColor\" value=\"#ffe885\" condition=\"fullWidth==false\">\n    <input type=\"checkbox\" title=\"Gradient\" name=\"gradientBg\" checked condition=\"fullWidth==false\">\n    <input type=\"color\" title=\"Color 2\" name=\"color2\" value=\"#ffffff\" condition=\"gradientBg\">\n    <!-- End block parameters -->\n    </mbr-parameters>\n<br><br>\n<div style=\"margin: 20px; display: flex; align-items: center; justify-content: center;\">\n  <div style=\"border: 3px solid rgb(200,0,0); padding: 0px 0px 0px 0px;\n    width: 360px;\n    height: 620px;\n    box-sizing: border-box;\n    display: flex;\n    flex-direction: column;\n    justify-content: center;\">\n    \n    <!-- Внутренний блок с отступом -->\n    <div style=\"padding: 10px; /* здесь регулируешь отступ между рамкой и видео */\n      width: 100%;\n      height: 100%;\n      box-sizing: border-box;\">\n      \n      <!-- iframe занимает всю внутреннюю область -->\n      <iframe allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\" allowfullscreen frameborder=\"0\" src=\"https://dzen.ru/embed/o-EYekjgJAAA?hide_logo=1&from_block=partner&from=zen&mute=0&autoplay=0&tv=1\" style=\"width: 100%; height: 100%; display: block;\">\n      </iframe>\n    </div>\n  </div>\n</div>\n\n            \n</section>",
